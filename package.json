{
  "name": "claude-token-killer",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code mod: rewrites git status, git diff, git show and recursive grep into token-compact forms, then compacts command output in process.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "claude plugin test .",
    "check:manifest": "node --experimental-strip-types scripts/manifest-check.mjs",
    "test:live": "node --experimental-strip-types scripts/live-tools.mjs",
    "test:live:windows": "node --experimental-strip-types scripts/live-windows.mjs",
    "validate": "claude plugin validate ."
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
